 drivers/gpu/drm/msm/Makefile              |   4 +
 drivers/gpu/drm/msm/dcp/dcp_hfi.h         |  31 +++
 drivers/gpu/drm/msm/dcp/dcp_hfi_crtc.c    | 191 ++++++++++++++++++
 drivers/gpu/drm/msm/dcp/dcp_hfi_encoder.c |  60 ++++++
 drivers/gpu/drm/msm/dcp/dcp_hfi_kms.c     | 325 ++++++++++++++++++++++++++++++
